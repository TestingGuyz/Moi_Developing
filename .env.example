# API Keys - Required
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional API Keys (for enhanced features)
NVIDIA_API_KEY=your_nvidia_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration
DEFAULT_TEMPERATURE=0.7

# Image Generation Notes:
# - Pollinations.ai and A4F are FREE and require NO API key (always available)
# - OpenRouter has free models available (optional, needs API key from openrouter.ai)
# - Hugging Face has free tier (optional, needs token from huggingface.co)